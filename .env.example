# ============================================================================
# site-2（芯火个人品牌博客）环境变量模板 (.env.example)
# 通俗说明：这个文件列出网站可能用到的所有外部开关。
# 在本地练习时，运行 .agents/setup.ps1 会自动复制生成 .env.local 并填入「安全假密码」，
# 你不需要自己去注册任何国外账号或填写真实银行卡！
# ============================================================================

# 1. 公开网址身份（用于自动生成搜索引擎户口本 sitemap.xml、RSS 送报单和微信分享海报）
PUBLIC_SITE_URL=http://127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000

# 2. 站长身份与安全密钥（本地使用安全假密钥即可；未配置外部服务时系统自动安全关闭对应写操作）
ADMIN_EMAIL=owner@xinhuo.local
NEXT_PUBLIC_ADMIN_PASSWORD=xinhuo2026
AMA_ENCRYPTION_KEY=
RATE_LIMIT_HASH_KEY=

# 3. 数据库连接（公开博客文章与项目直接读取仓库 content/ 文件夹，完全不依赖数据库！）
DATABASE_URL=

# 4. 可选：站长登录认证 (Clerk) —— 本地免密码练习场自动使用开发占位符
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 5. 可选：私密简历访问口令（留空则默认加锁关闭，防止隐私泄露）
RESUME_PASSPHRASE=
RESUME_SESSION_SECRET=
